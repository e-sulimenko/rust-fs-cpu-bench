{
  "resource_limits": {
    "kernel_space_heap_size": "1GB",
    "kernel_space_stack_size": "1MB",
    "user_space_size": "16GB",
    "max_num_of_threads": 512
  },
  "process": {
    "default_stack_size": "4MB",
    "default_heap_size": "32MB",
    "default_mmap_size": "100MB"
  },
  "entry_points": [
    "/bin"
  ],
  "env": {
    "default": [
      "OCCLUM=yes",
      "MAX_WRITE_FILE_SIZE=",
      "MAX_READ_FILE_SIZE=",
      "SEEK_SKIP_BYTES=",
      "READ_BYTES=",
      "MMAP_READ_BYTES=",
      "FS_TEST_RUNS_COUNT=1",
      "CPU_NUM_CALCS=",
      "CPU_TEST_RUNS_COUNT=",
      "CPU_MAX_THREADS=",
      "CPU_OPERATION_DIFFICULT_LEVEL="
    ],
    "untrusted": [
      "MAX_WRITE_FILE_SIZE",
      "MAX_READ_FILE_SIZE",
      "SEEK_SKIP_BYTES",
      "READ_BYTES",
      "MMAP_READ_BYTES",
      "FS_TEST_RUNS_COUNT",
      "CPU_NUM_CALCS",
      "CPU_TEST_RUNS_COUNT",
      "CPU_MAX_THREADS",
      "CPU_OPERATION_DIFFICULT_LEVEL"
    ]
  },
  "metadata": {
    "product_id": 0,
    "version_number": 0,
    "sgx_mode": "HW",
    "debuggable": false,
    "enable_kss": false,
    "family_id": {
      "high": "0x0",
      "low": "0x0"
    },
    "ext_prod_id": {
      "high": "0x0",
      "low": "0x0"
    }
  },
  "feature": {
    "amx": 0,
    "pkru": 0,
    "io_uring": 0,
    "enable_edmm": false,
    "enable_posix_shm": false
  },
  "mount": [
    {
      "target": "/",
      "type": "unionfs",
      "options": {
        "layers": [
          {
            "target": "/",
            "type": "sefs",
            "source": "./build/mount/__ROOT",
            "options": {
              "MAC": ""
            }
          },
          {
            "target": "/",
            "type": "sefs",
            "source": "./run/mount/__ROOT"
          }
        ]
      }
    },
    {
      "target": "/host",
      "type": "hostfs",
      "source": "."
    }
  ]
}
